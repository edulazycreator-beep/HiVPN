<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Split tunneling needs the list of apps the user can pick from. Android 11+ hides
        installed apps by default; this declares visibility of launchable apps only,
        instead of QUERY_ALL_PACKAGES (which needs Play Store approval).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
